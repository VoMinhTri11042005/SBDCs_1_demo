# SBDCs local/demo config
JWT_SECRET=YOUR_SUPER_SECRET_KEY
DATABASE_PATH=/app/data/database.sqlite

# Email recommendation mode
# mock = log email in database only, safe for demo and avoids spam/cost
# smtp = send real email through SMTP settings below
EMAIL_MODE=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_USE_TLS=true
